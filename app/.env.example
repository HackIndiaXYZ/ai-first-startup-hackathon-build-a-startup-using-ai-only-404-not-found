# Server-side only: never prefix these with VITE_, never commit a real key.
# Set ONE of these to turn on live AI mode (agent + document reading).
# Without any of them, Chhat runs fully on-device.

# GroqCloud (https://console.groq.com/keys). Keys start with gsk_
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=        # optional: a Groq model that reads photos

# xAI Grok (https://console.x.ai). Keys start with xai-
# XAI_API_KEY=
# XAI_MODEL=grok-4

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=
